# --- Clerk ---
# Récupérez ces deux valeurs dans le dashboard Clerk : https://dashboard.clerk.com
# (API Keys -> Show secret key, et la Publishable Key)
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optionnel : URL d'émetteur du JWT (issuer). Si vide, calculée depuis la publishable key.
# Exemple : https://clean-ape-12.clerk.accounts.dev
# CLERK_JWT_ISSUER=

# --- Server ---
PORT=3000

# --- CORS ---
# Origins autorisés (séparés par des virgules). * = tout autoriser (dev uniquement).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173,http://localhost:8080

# --- DB ---
# Fichier SQLite. ":memory:" pour une base purement en mémoire (perdue au reboot).
DB_PATH=./data/tycoon.sqlite
